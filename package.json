{
  "name": "epoch-cycling",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/gen-brand.mjs && astro build && node scripts/vercel-postbuild.mjs && node scripts/check-copy.mjs",
    "build:strict": "node scripts/gen-brand.mjs && astro build && node scripts/vercel-postbuild.mjs && node scripts/check-copy.mjs --strict",
    "preview": "astro preview",
    "check:copy": "node scripts/check-copy.mjs",
    "check:links": "bash scripts/check-links.sh",
    "astro": "astro",
    "og": "node scripts/gen-og.cjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/sitemap": "^3.7.5",
    "@astrojs/vercel": "^11.0.22",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/cli": "^4.14.0",
    "linkinator": "^8.1.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}