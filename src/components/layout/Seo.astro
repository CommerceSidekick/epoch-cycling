---
import { SITE } from "../../config/site";
import { orgSchema, websiteSchema, breadcrumbSchema } from "../../lib/schema";
interface Props {
  title: string; description: string; noindex?: boolean; ogImage?: string;
  breadcrumbs?: { name: string; path: string }[]; schema?: object[]; type?: "website" | "article";
}
const { title, description, noindex = false, ogImage, breadcrumbs, schema = [], type = "website" } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const OG: [RegExp, string][] = [[/^\/(ride|join)/, "ride"], [/^\/fuel/, "fuel"], [/^\/optimize/, "optimize"], [/^\/mtb/, "mtb"], [/^\/gravel/, "gravel"], [/^\/road/, "road"]];
const ogPick = ogImage ?? `/og/${OG.find(([re]) => re.test(path))?.[1] ?? "default"}.jpg`;
const canonical = `${SITE.url}${path === "/" ? "" : path}`;
const isPreview = process.env.VERCEL_ENV === "preview" || process.env.PUBLIC_PREVIEW === "true";
const robots = noindex || isPreview ? "noindex, follow" : "index, follow";
const og = ogPick.startsWith("http") ? ogPick : `${SITE.url}${ogPick}`;
const ld = [orgSchema(), websiteSchema(), ...(breadcrumbs && path !== "/" ? [breadcrumbSchema([{ name: "Home", path: "/" }, ...breadcrumbs])] : []), ...schema];
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Epoch Cycling" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />
{ld.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
