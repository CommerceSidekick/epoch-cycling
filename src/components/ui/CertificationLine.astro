---
import { SITE } from "../../config/site";
import Ph from "./Ph.astro";
const c = SITE.certification;
---
{SITE.flags.certifiedForSport ? (
  <p>Epoch Fuel and Epoch Salt are certified by <Ph value={c.program} label="certification program" />. Look up your batch at <Ph value={c.lookupUrl} label="batch lookup URL" />.</p>
) : (
  <p>Epoch Fuel and Salt aren't third-party certified for sport yet. We're working on it. Until then, check the label against your federation's rules yourself.</p>
)}
