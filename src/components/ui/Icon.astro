---
// Lucide-style line icons (1.75 stroke, square caps, 24 grid). Paths adapted from Lucide (ISC).
type N = "arrow-right" | "arrow-up-right" | "chevron-down" | "menu" | "x" | "instagram" | "tiktok" | "youtube" | "strava" | "calendar" | "map-pin" | "mountain" | "clock" | "check" | "mail" | "download" | "share" | "play" | "pause" | "external" | "shield" | "alert";
interface Props { name: N; size?: number; class?: string; label?: string }
const { name, size = 20, class: cls = "", label } = Astro.props;
const P: Record<N, string> = {
  "arrow-right": '<path d="M5 12h14M13 6l6 6-6 6"/>',
  "arrow-up-right": '<path d="M7 17L17 7M8 7h9v9"/>',
  external: '<path d="M7 17L17 7M8 7h9v9"/>',
  "chevron-down": '<path d="M6 9l6 6 6-6"/>',
  menu: '<path d="M3 6h18M3 12h18M3 18h18"/>',
  x: '<path d="M6 6l12 12M18 6L6 18"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/>',
  tiktok: '<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.5 2.5 2.5 4.5 5 4.5"/>',
  youtube: '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9.5l5 2.5-5 2.5z"/>',
  strava: '<path d="M10 3l-6 12h4l2-4 2 4h4zM14 15l2 4 2-4"/>',
  calendar: '<rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/>',
  "map-pin": '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  mountain: '<path d="M3 20l6.5-11 4 6.5 2.5-4L21 20z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  check: '<path d="M4.5 12.5l5 5L19.5 7"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6l8.5 7 8.5-7"/>',
  download: '<path d="M12 3v12M6.5 10L12 15.5 17.5 10M4 20h16"/>',
  share: '<circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="M8.2 10.8l7.6-4.4M8.2 13.2l7.6 4.4"/>',
  play: '<path d="M7 4.5l13 7.5-13 7.5z"/>',
  pause: '<path d="M7 4.5v15M17 4.5v15"/>',
  shield: '<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/>',
  alert: '<path d="M12 3l10 18H2zM12 10v5M12 18h.01"/>',
};
---
<svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter" class={cls} aria-hidden={label ? undefined : "true"} role={label ? "img" : undefined} aria-label={label} focusable="false" set:html={P[name]} />
