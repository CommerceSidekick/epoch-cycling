---
// Non-photo page header with topo texture and a giant outlined background word.
import Eyebrow from "../ui/Eyebrow.astro";
interface Props { eyebrow?: string; ghost?: string; class?: string; bar?: string; light?: boolean }
const { eyebrow, ghost, class: cls = "", bar, light = false } = Astro.props;
---
<section class={`page-header topo ${light ? "on-light" : ""} ${cls}`}>
  {ghost && <div class="ghost" aria-hidden="true">{ghost}</div>}
  <div class="wrap ph-inner">
    {eyebrow && <Eyebrow bar={bar}>{eyebrow}</Eyebrow>}
    <slot />
  </div>
</section>
<style>
  .page-header { position: relative; overflow: hidden; padding-top: clamp(168px, 16vw, 210px); padding-bottom: clamp(56px, 8vw, 96px); border-bottom: 1px solid var(--color-slate); }
  .on-light.page-header { border-bottom-color: #ddd6c8; }
  .ghost { position: absolute; right: -2vw; bottom: -0.12em; font-family: var(--font-display); font-weight: 900; font-stretch: 125%; font-size: clamp(6rem, 22vw, 22rem); line-height: 0.8; text-transform: uppercase; color: transparent; -webkit-text-stroke: 1.5px var(--color-slate); white-space: nowrap; pointer-events: none; user-select: none; }
  .on-light .ghost { -webkit-text-stroke-color: #d9d2c3; }
  .ph-inner { position: relative; display: grid; gap: 22px; }
</style>
