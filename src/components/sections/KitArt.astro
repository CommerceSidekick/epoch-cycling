---
// Illustrated kit mockups (no printed kits until trademark clearance, L1). Placement follows 3.6:
// EPOCH on the chest, discipline tag on the left sleeve, three marks on the right sleeve,
// topo lines across the lower third on MTB, Signal cuff stripe for Club racers.
import { MARK_PATHS, WORDMARK_STROKES, ICONS } from "../../lib/brand-geometry.mjs";
interface Props { art: "trail-jersey" | "race-jersey" | "baggies" | "trucker"; label: string; racer?: boolean; tag?: string }
const { art, label, racer = false, tag = "MTB" } = Astro.props;
const word = WORDMARK_STROKES.map((d) => `<path d="${d}"/>`).join("");
const mark = MARK_PATHS.map((d) => `<path d="${d}"/>`).join("");
const icon = (n: "ride" | "fuel" | "optimize") => ICONS[n]("outline", "#F2EEE6");
const uid = art;
---
<svg viewBox="0 0 400 400" role="img" aria-label={label} class="kit-art">
  <defs>
    <clipPath id={`clip-${uid}`}>
      {art === "trail-jersey" && <path d="M120 70 L165 52 Q200 72 235 52 L280 70 L360 130 L330 190 L292 168 L292 352 Q200 366 108 352 L108 168 L70 190 L40 130 Z" />}
      {art === "race-jersey" && <path d="M126 70 L168 54 Q200 70 232 54 L274 70 L350 120 L340 300 L300 300 L292 160 L292 352 Q200 362 108 352 L108 160 L100 300 L60 300 L50 120 Z" />}
      {art === "baggies" && <path d="M92 80 H308 L330 330 L224 342 L200 196 L176 342 L70 330 Z" />}
      {art === "trucker" && <path d="M86 236 Q86 104 200 100 Q314 104 314 236 Z" />}
    </clipPath>
    <pattern id={`topo-${uid}`} width="120" height="60" patternUnits="userSpaceOnUse">
      <path d="M0 30 Q30 10 60 30 T120 30 M0 48 Q30 28 60 48 T120 48 M0 12 Q30 -8 60 12 T120 12" fill="none" stroke="#F2EEE6" stroke-opacity=".12" stroke-width="1.2" />
    </pattern>
  </defs>
  <g clip-path={`url(#clip-${uid})`}>
    <rect width="400" height="400" fill="#16171A" />
    {art !== "trucker" && <rect y="250" width="400" height="150" fill={`url(#topo-${uid})`} />}
    {art === "trucker" && <rect y="100" width="400" height="140" fill="#1C1E1A" />}
    {art === "trucker" && <path d="M200 100 V236" stroke="#2E312B" stroke-width="2" />}
    {art === "trucker" && <rect x="86" y="160" width="228" height="80" fill="#0E0F0C" opacity=".55" />}
    {(art === "trail-jersey" || art === "race-jersey") && (
      <>
        <path d="M108 168 L70 190 L40 130 L120 70" fill="none" stroke="#2E312B" stroke-width="3" />
        <path d="M292 168 L330 190 L360 130 L280 70" fill="none" stroke="#2E312B" stroke-width="3" />
      </>
    )}
  </g>
  {(art === "trail-jersey" || art === "race-jersey") && (
    <>
      <g transform="translate(138 150) scale(0.19)" fill="none" stroke="#F2EEE6" stroke-width="13.5" set:html={word} />
      <g transform="translate(176 112) scale(0.115) translate(-205 -82)" fill="#2D8CFF" set:html={mark} />
      <text x="72" y={art === "race-jersey" ? 168 : 152} transform={`rotate(${art === "race-jersey" ? 84 : 32} 72 ${art === "race-jersey" ? 168 : 152})`} font-family="Archivo Variable, sans-serif" font-weight="900" font-size="18" letter-spacing="2" fill="#2D8CFF" style="font-stretch:125%">{tag}</text>
      <g transform={art === "race-jersey" ? "translate(318 150)" : "translate(312 112) rotate(-32)"}>
        <g transform="scale(0.8)" set:html={icon("ride")} />
        <g transform="translate(0 24) scale(0.8)" set:html={icon("fuel")} />
        <g transform="translate(0 48) scale(0.8)" set:html={icon("optimize")} />
      </g>
      {racer && <path d={art === "race-jersey" ? "M62 290 H98" : "M48 150 L68 186"} stroke="#D4FF3A" stroke-width="7" />}
    </>
  )}
  {art === "baggies" && (
    <>
      <path d="M92 80 H308 L310 104 H90 Z" fill="#2E312B" />
      <g transform="translate(110 250) scale(0.09) translate(-205 -82)" fill="#2D8CFF" set:html={mark} />
      <g transform="translate(254 290) scale(0.11)" fill="none" stroke="#F2EEE6" stroke-width="13.5" set:html={word} />
    </>
  )}
  {art === "trucker" && (
    <>
      <path d="M60 236 Q200 270 350 236 Q352 258 330 262 Q200 290 70 262 Q56 258 60 236Z" fill="#0E0F0C" />
      <g transform="translate(150 140) scale(0.24) translate(-205 -82)" fill="#2D8CFF" set:html={mark} />
      <g transform="translate(132 208) scale(0.2)" fill="none" stroke="#F2EEE6" stroke-width="13.5" set:html={word} />
    </>
  )}
</svg>
<style>
  .kit-art { width: 100%; height: auto; }
</style>
