---
// Three expanding panels. MTB large and live, Gravel and Road with a SOON tag. Snap-scroll on mobile.
import Photo from "./Photo.astro";
import Icon from "../ui/Icon.astro";
const panels = [
  { key: "mtb", name: "Epoch MTB", tag: "MTB", body: "Enduro, XC, downhill and every trail in between. Live now.", cta: "Ride Epoch MTB", href: "/mtb", img: "mtbCharge" as const, live: true, pos: "center 30%" },
  { key: "gravel", name: "Epoch Gravel", tag: "GRAVEL", body: "Long dirt roads and longer days. Coming next.", cta: "Get notified", href: "/join?interest=gravel", img: "gravelDescent" as const, live: false, pos: "center 60%" },
  { key: "road", name: "Epoch Road", tag: "ROAD", body: "Pacelines, crits and fast mornings. Coming after that.", cta: "Get notified", href: "/join?interest=road", img: "roadPeloton" as const, live: false, pos: "center" },
];
---
<ul class="dpanels" role="list">
  {panels.map((p) => (
    <li class={`dpanel ${p.live ? "is-live" : ""}`} data-discipline={p.key}>
      <div class="dp-media photo">
        <Photo img={p.img} position={p.pos} sizes="(min-width: 1024px) 50vw, 85vw" widths={[480, 800, 1200]} />
      </div>
      <div class="dp-shade" aria-hidden="true"></div>
      <div class="dp-content">
        <div class="flex items-center gap-2">
          <span class="tag tag-disc">{p.tag}</span>
          {p.live ? <span class="tag tag-dark">LIVE</span> : <span class="tag">SOON</span>}
        </div>
        <h3 class="dp-title">{p.name}</h3>
        <p class="dp-body">{p.body}</p>
        <a href={p.href} class="dp-cta link-arrow" style="--link-accent: var(--disc)"><span>{p.cta}</span><Icon name="arrow-right" size={18} class="arr" /></a>
      </div>
      <span class="dp-vert" aria-hidden="true">{p.tag}</span>
    </li>
  ))}
</ul>
<style>
  .dpanels { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: 84%; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 6px; }
  .dpanel { position: relative; isolation: isolate; overflow: hidden; border-radius: var(--radius-md); min-height: 520px; scroll-snap-align: start; border: 1px solid var(--color-slate); display: flex; }
  .dpanel::after { content: ""; position: absolute; inset: 0; border-bottom: 6px solid var(--disc); pointer-events: none; border-radius: inherit; }
  .dp-media { position: absolute; inset: 0; z-index: -2; }
  .dp-media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease), filter 600ms var(--ease); }
  .dpanel:not(.is-live) .dp-media :global(img) { filter: grayscale(0.85) contrast(1.1); }
  .dp-shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgb(14 15 12 / 0.96) 0%, rgb(14 15 12 / 0.5) 48%, rgb(14 15 12 / 0.15) 100%); }
  .dp-content { align-self: flex-end; display: grid; gap: 12px; padding: clamp(22px, 3vw, 34px); }
  .dp-title { font-family: var(--font-display); font-weight: 900; font-stretch: 125%; text-transform: uppercase; font-size: clamp(2rem, 3.6vw, 3.5rem); line-height: 0.92; }
  .dp-title::first-line { color: var(--color-bone); }
  .dp-body { max-width: 34ch; color: #e7e2d6; }
  .dp-cta { color: var(--color-bone); }
  .dp-cta::after { content: ""; position: absolute; inset: 0; z-index: 3; }
  .dp-vert { position: absolute; top: 20px; right: 16px; z-index: -1; writing-mode: vertical-rl; font-family: var(--font-display); font-weight: 900; font-stretch: 125%; font-size: clamp(2.5rem, 3.6vw, 3.75rem); line-height: 1; color: transparent; -webkit-text-stroke: 1.5px var(--disc); opacity: 0.75; pointer-events: none; }
  .dpanel:hover .dp-media :global(img), .dpanel:focus-within .dp-media :global(img) { transform: scale(1.06); filter: none; }
  .dpanel:has(.dp-cta:focus-visible) { outline: 2px solid var(--color-signal); outline-offset: 3px; }
  @media (min-width: 1024px) {
    .dpanels { grid-auto-flow: unset; display: flex; overflow: visible; gap: 14px; }
    .dpanel { flex: 1 1 0; min-height: 620px; transition: flex-grow 700ms var(--ease); }
    .dpanel.is-live { flex-grow: 1.9; }
    .dpanels:hover .dpanel { flex-grow: 1; }
    .dpanels:hover .dpanel:hover, .dpanels .dpanel:focus-within { flex-grow: 2.2; }
  }
  @media (prefers-reduced-motion: reduce) { .dpanel { transition: none; } }
</style>
