---
import Photo from "./Photo.astro";
import type { ImgKey } from "../../lib/images";
interface Props { title: string; sub?: string; img?: ImgKey; id?: string; position?: string; duo?: string; class?: string; center?: boolean }
const { title, sub, img, id, position = "center", duo, class: cls = "", center = true } = Astro.props;
---
<section id={id} class={`cta-band ${img ? "has-img" : "topo"} ${cls}`}>
  {img && (
    <div class={`cta-media photo ${duo ? "duo" : ""}`} style={duo ? `--duo:${duo}` : undefined}>
      <Photo img={img} position={position} sizes="100vw" widths={[640, 1024, 1600]} decorative />
    </div>
  )}
  <div class={`wrap cta-inner ${center ? "text-center items-center" : ""}`}>
    <h2 class="t-display reveal">{title}</h2>
    {sub && <p class="body-l reveal reveal-d1 cta-sub">{sub}</p>}
    <div class={`cta-actions reveal reveal-d2 ${center ? "justify-center" : ""}`}><slot /></div>
  </div>
</section>
<style>
  .cta-band { position: relative; isolation: isolate; overflow: hidden; padding-block: clamp(96px, 14vw, 200px); }
  .cta-media { position: absolute; inset: 0; z-index: -2; }
  .cta-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .has-img::after { content: ""; position: absolute; inset: 0; z-index: -1; background: radial-gradient(ellipse at center, rgb(14 15 12 / 0.4), rgb(14 15 12 / 0.82)); }
  .cta-inner { display: flex; flex-direction: column; gap: 24px; }
  .cta-sub { max-width: 46ch; color: #e7e2d6; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 16px 22px; margin-top: 8px; }
</style>
