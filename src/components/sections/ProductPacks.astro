---
// Epoch Endurance, Epoch Fuel and Epoch Edge as packaging cards: the same line as Epoch Health System.
// Illustrations only: final packaging waits on trademark clearance (L1) and the final labels.
interface Props { class?: string; size?: "md" | "lg" }
const { class: cls = "", size = "md" } = Astro.props;
---
<div class={`packs packs-${size} ${cls}`} role="img" aria-label="Illustration of Epoch Endurance, Epoch Fuel and Epoch Edge packaging">
  <div class="pack pack-endurance" aria-hidden="true">
    <span class="pack-eyebrow mono">EPOCH</span>
    <span class="pack-word pack-word-long">ENDURANCE</span>
    <span class="pack-dots"><span>K</span><span>Mg</span><span>OKG</span></span>
  </div>
  <div class="pack pack-fuel" aria-hidden="true">
    <span class="pack-eyebrow mono">EPOCH</span>
    <span class="pack-word">FUEL</span>
    <span class="pack-line mono">Performance. Recovery.</span>
  </div>
  <div class="pack pack-edge" aria-hidden="true">
    <span class="pack-eyebrow mono">EPOCH</span>
    <span class="pack-word">EDGE</span>
    <span class="pack-line mono">Focus. Mental game.</span>
  </div>
</div>
<style>
  /* Explicit width: each pack uses container units, so the row cannot size itself from its children */
  .packs { position: relative; display: flex; align-items: flex-start; justify-content: center; gap: 0; padding: 30px 10px 56px; width: min(100%, 640px); margin-inline: auto; }
  .pack { container-type: inline-size; position: relative; display: flex; flex-direction: column; width: min(36%, 210px); aspect-ratio: 3 / 4.1; padding: 16px; border-radius: 14px; box-shadow: 0 40px 70px -30px rgb(0 0 0 / 0.85); transition: transform 500ms var(--ease); }
  .packs-lg .pack { width: min(36%, 240px); }
  .pack-endurance { background: linear-gradient(160deg, #56664b, var(--color-moss) 60%); border: 1px solid rgb(183 198 160 / 0.25); transform: rotate(-5deg) translateX(14%); z-index: 1; }
  .pack-fuel { background: linear-gradient(160deg, #22241f, var(--color-carbon) 70%); border: 1px solid rgb(45 140 255 / 0.35); transform: rotate(1deg) translateY(22px); z-index: 3; }
  .pack-edge { background: linear-gradient(160deg, #3a3e36, var(--color-slate) 70%); border: 1px solid rgb(143 184 201 / 0.35); transform: rotate(6deg) translate(-14%, 6px); z-index: 2; }
  .packs:hover .pack-endurance { transform: rotate(-7deg) translate(10%, -6px); }
  .packs:hover .pack-fuel { transform: rotate(0deg) translateY(14px); }
  .packs:hover .pack-edge { transform: rotate(8deg) translate(-10%, 0); }
  .pack-eyebrow { font-size: 0.75rem; letter-spacing: 0.18em; color: var(--color-sage); }
  .pack-fuel .pack-eyebrow { color: var(--color-summit); }
  .pack-edge .pack-eyebrow { color: var(--color-sky); }
  .pack-word { margin-top: auto; margin-bottom: auto; font-family: var(--font-display); font-weight: 900; font-stretch: 125%; font-size: 24cqi; line-height: 1; color: var(--color-bone); text-align: center; white-space: nowrap; }
  .pack-word-long { font-size: 12.5cqi; font-stretch: 110%; }
  .pack-dots { display: flex; gap: 6px; }
  .pack-dots span { display: grid; place-content: center; min-width: 30px; height: 30px; padding-inline: 4px; border-radius: 999px; border: 1.5px solid var(--color-sage); color: var(--color-sage); font-family: var(--font-mono); font-size: 0.75rem; }
  .pack-line { font-size: 0.75rem; color: var(--color-dust); letter-spacing: 0.06em; }
  @media (prefers-reduced-motion: reduce) { .pack { transition: none; } }
</style>
