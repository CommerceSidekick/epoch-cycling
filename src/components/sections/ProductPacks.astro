---
// Epoch Salt and Epoch Fuel shown as packaging cards (style carried over from epochhealthsystem.com).
// Illustrations only: final packaging waits on trademark clearance (L1) and the final labels.
interface Props { class?: string; size?: "md" | "lg" }
const { class: cls = "", size = "md" } = Astro.props;
---
<div class={`packs packs-${size} ${cls}`} role="img" aria-label="Illustration of Epoch Salt and Epoch Fuel packaging">
  <div class="pack pack-salt" aria-hidden="true">
    <span class="pack-eyebrow mono">EPOCH SALT</span>
    <span class="pack-word">SALT</span>
    <span class="pack-dots"><span>Na</span><span>K</span><span>Mg</span></span>
  </div>
  <div class="pack pack-fuel" aria-hidden="true">
    <span class="pack-eyebrow mono">EPOCH FUEL</span>
    <span class="pack-word">FUEL</span>
    <span class="pack-line mono">Long rides. Hot days.</span>
  </div>
</div>
<style>
  /* Explicit width: each pack uses container units, so the row cannot size itself from its children */
  .packs { position: relative; display: flex; align-items: flex-start; justify-content: center; gap: 0; padding: 30px 10px 40px; width: min(100%, 600px); margin-inline: auto; }
  .pack { container-type: inline-size; position: relative; display: flex; flex-direction: column; width: min(46%, 230px); aspect-ratio: 3 / 4.1; padding: 18px; border-radius: 14px; box-shadow: 0 40px 70px -30px rgb(0 0 0 / 0.85); transition: transform 500ms var(--ease); }
  .packs-lg .pack { width: min(46%, 270px); }
  .pack-salt { background: linear-gradient(160deg, #56664b, var(--color-moss) 60%); border: 1px solid rgb(212 255 58 / 0.25); transform: rotate(-4deg) translateX(8%); z-index: 1; }
  .pack-fuel { background: linear-gradient(160deg, #22241f, var(--color-carbon) 70%); border: 1px solid rgb(45 140 255 / 0.35); transform: rotate(3deg) translate(-6%, 34px); z-index: 2; }
  .packs:hover .pack-salt { transform: rotate(-6deg) translate(4%, -6px); }
  .packs:hover .pack-fuel { transform: rotate(5deg) translate(-2%, 26px); }
  .pack-eyebrow { font-size: 0.8125rem; letter-spacing: 0.14em; color: var(--color-signal); }
  .pack-fuel .pack-eyebrow { color: var(--color-summit); }
  .pack-word { margin-top: auto; margin-bottom: auto; font-family: var(--font-display); font-weight: 900; font-stretch: 125%; font-size: 21cqi; line-height: 1; color: var(--color-bone); text-align: center; white-space: nowrap; }
  .pack-dots { display: flex; gap: 8px; }
  .pack-dots span { display: grid; place-content: center; width: 34px; height: 34px; border-radius: 50%; border: 1.5px solid var(--color-signal); color: var(--color-signal); font-family: var(--font-mono); font-size: 0.8125rem; }
  .pack-line { font-size: 0.8125rem; color: var(--color-dust); letter-spacing: 0.06em; }
  @media (prefers-reduced-motion: reduce) { .pack { transition: none; } }
</style>
