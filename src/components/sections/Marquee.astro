---
interface Props { items?: string[]; class?: string }
const { items = ["RIDE", "FUEL", "OPTIMIZE", "NOW IS YOUR TIME", "DAWN PATROL IS A LIFESTYLE"], class: cls = "" } = Astro.props;
const row = [...items, ...items];
---
<div class={`marquee ${cls}`} aria-hidden="true">
  <div class="marquee-track">
    {[0, 1].map(() => (
      <span class="mq-set">
        {row.map((t, i) => (<span class={`mq-item ${i % 2 ? "t-outline-bone" : ""}`}>{t}<span class="mq-dot">·</span></span>))}
      </span>
    ))}
  </div>
</div>
<style>
  .marquee { border-block: 1px solid var(--color-slate); padding-block: 18px; background: var(--color-carbon); }
  .mq-set { display: inline-flex; }
  .mq-item { font-family: var(--font-display); font-weight: 900; font-stretch: 125%; font-size: clamp(2rem, 5vw, 4.25rem); line-height: 1; text-transform: uppercase; padding-right: 0.4em; display: inline-flex; align-items: center; gap: 0.4em; }
  .mq-dot { color: var(--color-dawn); -webkit-text-stroke: 0; }
</style>
