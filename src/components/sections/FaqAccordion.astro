---
import type { FaqEntry } from "../../content/faq";
import { mdInline } from "../../lib/md";
interface Props { entries: FaqEntry[]; headingLevel?: "h3" | "h4" }
const { entries } = Astro.props;
---
<div class="faq-list">
  {entries.map((f) => (
    <details class="faq" id={f.id} data-faq-id={f.id}>
      <summary><span>{f.q}</span><span class="pm" aria-hidden="true">+</span></summary>
      <div class="faq-a"><p set:html={mdInline(f.a)} /></div>
    </details>
  ))}
</div>
<script>
  // Open the entry targeted by the URL hash (deep links like /faq#anti-doping).
  const open = () => { const id = location.hash.slice(1); if (!id) return; const d = document.getElementById(id); if (d instanceof HTMLDetailsElement) { d.open = true; } };
  open(); addEventListener("hashchange", open);
</script>
