---
// Coming-soon discipline page template (5.9, 5.10). When the discipline goes live, swap to the /mtb structure.
import BaseLayout from "../layout/BaseLayout.astro";
import PageHero from "./PageHero.astro";
import Photo from "./Photo.astro";
import Lockup from "../brand/Lockup.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import type { ImgKey } from "../../lib/images";
interface Props {
  discipline: "gravel" | "road";
  metaTitle: string; metaDescription: string; path: string; crumb: string;
  eyebrow: string; h1: string[]; sub: string; notifyHref: string;
  heroImg: ImgKey; heroPos?: string; sideImgs: [ImgKey, ImgKey]; sidePos?: [string, string];
  coming: { t: string; b: string }[];
  untilBody: string;
  links: { label: string; href: string }[];
}
const p = Astro.props;
const word = p.discipline.toUpperCase();
---
<BaseLayout lcp={p.heroImg} title={p.metaTitle} description={p.metaDescription} discipline={p.discipline} overlayHeader breadcrumbs={[{ name: p.crumb, path: p.path }]}>
  <PageHero img={p.heroImg} eyebrow={p.eyebrow} size="full" position={p.heroPos ?? "center"} bar="var(--disc)" speed>
    <div class="cs-lockup reveal"><Lockup variant={p.discipline} size="md" /></div>
    <h1 class="t-display-xl cs-h1 reveal">
      {p.h1.map((line, i) => <span class={i === p.h1.length - 1 ? "text-disc" : ""}>{line}</span>)}
    </h1>
    <p class="body-l cs-sub reveal reveal-d1">{p.sub}</p>
    <div class="mt-8 reveal reveal-d2"><Button href={p.notifyHref} variant="accent" size="lg" arrow location={`${p.discipline}-hero`}>Get notified</Button></div>
    <span class="cs-soon" aria-hidden="true">SOON</span>
  </PageHero>

  <section class="section" aria-labelledby="coming-title">
    <div class="wrap cs-grid">
      <div class="cs-copy">
        <p class="eyebrow" style="--eyebrow-bar: var(--disc)">WHAT'S COMING</p>
        <h2 id="coming-title" class="t-h2">{word} is next on the list.</h2>
        <ol class="cs-list" role="list">
          {p.coming.map((c, i) => (
            <li class={`reveal reveal-d${i}`}>
              <span class="cs-n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div><p class="t-h3">{c.t}</p><p class="muted mt-1">{c.b}</p></div>
            </li>
          ))}
        </ol>
      </div>
      <div class="cs-mosaic" aria-hidden="true">
        <div class="cs-m1 photo"><Photo img={p.sideImgs[0]} sizes="(min-width: 1024px) 30vw, 60vw" widths={[480, 800]} position={p.sidePos?.[0] ?? "center"} decorative /></div>
        <div class="cs-m2 photo"><Photo img={p.sideImgs[1]} sizes="(min-width: 1024px) 25vw, 40vw" widths={[480, 800]} position={p.sidePos?.[1] ?? "center"} decorative /></div>
        <div class="cs-tag"><span class="race-number">EPOCH {word}</span><span class="tag">SOON</span></div>
      </div>
    </div>
  </section>

  <section class="section on-ridge topo" aria-labelledby="until-title">
    <div class="wrap">
      <div class="grid gap-5 mb-10 measure">
        <p class="eyebrow" style="--eyebrow-bar: var(--disc)">UNTIL THEN</p>
        <h2 id="until-title" class="t-h2">Ride now. Fuel now.</h2>
        <p class="body-l muted">{p.untilBody}</p>
      </div>
      <ul class="cs-links" role="list">
        {p.links.map((l, i) => (
          <li>
            <a href={l.href} class="cs-link">
              <span class="race-number">{String(i + 1).padStart(2, "0")}</span>
              <span class="t-h3">{l.label}</span>
              <Icon name="arrow-right" size={22} class="cs-arr" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .cs-lockup { color: var(--color-bone); margin-bottom: 24px; }
  .cs-h1 { max-width: 12ch; }
  .cs-h1 span { display: block; }
  .cs-sub { margin-top: 24px; max-width: 42ch; color: #ece7dc; }
  .cs-soon { display: none; }
  @media (min-width: 1200px) {
    .cs-soon { display: block; position: absolute; right: -0.04em; top: 50%; transform: translateY(-50%) rotate(-90deg) translateX(30%); transform-origin: right center; font-family: var(--font-display); font-weight: 900; font-stretch: 125%; font-size: 11rem; line-height: 1; color: transparent; -webkit-text-stroke: 2px var(--disc); opacity: 0.65; }
  }
  .cs-grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1024px) { .cs-grid { grid-template-columns: 1.1fr 0.9fr; } }
  .cs-copy { display: grid; gap: 22px; }
  .cs-list { list-style: none; margin: 8px 0 0; padding: 0; display: grid; }
  .cs-list li { display: grid; grid-template-columns: auto 1fr; gap: 20px; padding: 22px 0; border-top: 1px solid var(--color-slate); }
  .cs-list li:last-child { border-bottom: 1px solid var(--color-slate); }
  .cs-n { font-family: var(--font-display); font-weight: 900; font-stretch: 125%; font-size: 2.75rem; line-height: 0.9; color: transparent; -webkit-text-stroke: 1.5px var(--disc); }
  .cs-mosaic { position: relative; min-height: 460px; }
  .cs-m1, .cs-m2 { position: absolute; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--color-slate); }
  .cs-m1 { left: 0; top: 0; width: 68%; height: 78%; }
  .cs-m2 { right: 0; bottom: 0; width: 52%; height: 58%; border-bottom: 6px solid var(--disc); }
  .cs-m1 :global(img), .cs-m2 :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .cs-m1 :global(img) { filter: grayscale(0.6) contrast(1.1); }
  .cs-tag { position: absolute; left: 6%; bottom: 8%; z-index: 2; display: flex; gap: 10px; align-items: center; background: var(--color-carbon); border: 1px solid var(--color-slate); padding: 10px 14px; border-radius: 6px; color: var(--disc); }
  .cs-links { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  @media (min-width: 768px) { .cs-links { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .cs-links { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .cs-link { display: grid; gap: 22px; min-height: 160px; align-content: space-between; padding: 24px; border-radius: var(--radius-md); background: var(--color-carbon); border: 1px solid var(--color-slate); text-decoration: none; position: relative; transition: border-color var(--dur-ui) var(--ease), transform 260ms var(--ease); }
  .cs-link .race-number { color: var(--disc); }
  .cs-link:hover { border-color: var(--disc); transform: translateY(-4px); }
  :global(.cs-arr) { position: absolute; right: 22px; bottom: 24px; color: var(--disc); transition: transform var(--dur-ui) var(--ease); }
  .cs-link:hover :global(.cs-arr) { transform: translateX(4px); }
</style>
