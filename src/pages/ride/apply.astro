---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import PageHeader from "../../components/sections/PageHeader.astro";
import Photo from "../../components/sections/Photo.astro";
import RidersClubApplicationForm from "../../components/forms/RidersClubApplicationForm.astro";
import LinkArrow from "../../components/ui/LinkArrow.astro";
import { SITE } from "../../config/site";
const rc = SITE.ridersClub;
---
<BaseLayout
  title="Apply | Club Racer or Ambassador | Epoch Riders Club"
  description="Apply to race with the Epoch Riders Club or become an ambassador. Fuel with Epoch, race in the kit, and we'll help cover your entry. All levels welcome."
  breadcrumbs={[{ name: "Riders Club", path: "/ride" }, { name: "Apply", path: "/ride/apply" }]}
>
  <PageHeader eyebrow="EPOCH RIDERS CLUB" ghost="APPLY">
    <h1 class="t-display apply-h1">Apply to ride for <span class="text-summit">Epoch.</span></h1>
    <p class="body-l muted measure">Club racer, ambassador, or both. Every level is welcome. Takes about 4 minutes. We review applications {rc.reviewCadence}.</p>
    <p class="small apply-note"><span class="tag tag-disc" data-discipline="mtb">MTB</span> MTB spots open first. Gravel and road racers can apply now and get first look when those open.</p>
  </PageHeader>

  <section class="section">
    <div class="wrap apply-grid">
      <div class="apply-form">
        <RidersClubApplicationForm />
      </div>
      <aside class="apply-aside" aria-labelledby="aside-title">
        <div class="aside-card card">
          <div class="aside-photo photo">
            <Photo img="mtbDustyRace" sizes="(min-width: 1024px) 30vw, 100vw" widths={[480, 800]} position="center 40%" />
          </div>
          <div class="aside-body">
            <h2 id="aside-title" class="t-h3 uppercase">The deal, in short.</h2>
            <ol class="aside-steps" role="list">
              <li><span class="race-number">01</span>Get accepted as a Club racer.</li>
              <li><span class="race-number">02</span>Race in the kit. Fuel with Epoch Fuel or Salt.</li>
              <li><span class="race-number">03</span>Send proof. We help cover your entry under the club terms.</li>
            </ol>
            <p class="fine">The race deal is about fuel and kit. It never depends on any medical program.</p>
            <div class="grid gap-1">
              <LinkArrow href="/ride/sponsorship">How the race deal works</LinkArrow>
              <LinkArrow href="/riders-club-terms">Riders Club terms</LinkArrow>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .apply-h1 { max-width: 14ch; }
  .apply-note { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; color: #d9d4c8; }
  .apply-grid { display: grid; gap: 40px; }
  @media (min-width: 1100px) { .apply-grid { grid-template-columns: minmax(0, 1fr) 360px; align-items: start; } .apply-aside { position: sticky; top: 110px; } }
  .aside-photo { aspect-ratio: 16 / 10; }
  .aside-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .aside-body { display: grid; gap: 16px; padding: 24px; }
  .aside-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .aside-steps li { display: grid; grid-template-columns: 34px 1fr; gap: 8px; }
  .aside-steps .race-number { color: var(--color-summit); padding-top: 2px; }
</style>
