---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import PageHeader from "../../components/sections/PageHeader.astro";
import RiderGrid from "../../components/sections/RiderGrid.astro";
import FilterBar from "../../components/sections/FilterBar.astro";
import Photo from "../../components/sections/Photo.astro";
import Button from "../../components/ui/Button.astro";
import { getCollection } from "astro:content";
import { SITE } from "../../config/site";
const visible = SITE.flags.showRiders ? (await getCollection("riders")).filter((r) => r.data.consentOnFile && !r.data.placeholder && r.data.role !== "staff") : [];
---
<BaseLayout
  title="The Team | Club Racers and Ambassadors | Epoch Riders Club"
  description="Meet the Epoch Riders Club: Club racers, ambassadors and ride hosts across mountain bike, gravel and road."
  breadcrumbs={[{ name: "Riders Club", path: "/ride" }, { name: "The team", path: "/ride/team" }]}
>
  <PageHeader eyebrow="THE TEAM" ghost="CREW">
    <h1 class="t-display-xl">The <span class="text-summit">crew.</span></h1>
    <p class="body-l muted measure">Club racers, ambassadors and the people who host the rides.</p>
  </PageHeader>

  <section class="section" aria-label="Riders">
    <div class="wrap">
      {visible.length > 0 && (
        <FilterBar
          noun={["rider", "riders"]}
          groups={[
            { key: "discipline", label: "Discipline", attr: "data-filter-discipline", options: [{ value: "mtb", label: "MTB" }, { value: "gravel", label: "Gravel" }, { value: "road", label: "Road" }] },
            { key: "role", label: "Role", attr: "data-filter-role", options: [{ value: "racer", label: "Club racers" }, { value: "ambassador", label: "Ambassadors" }, { value: "host", label: "Ride hosts" }] },
          ]}
        />
      )}
      <RiderGrid>
        <div slot="empty" class="roster card">
          <div class="roster-media photo" aria-hidden="true">
            <Photo img="mtbDustyRace" sizes="(min-width: 1024px) 50vw, 100vw" widths={[640, 1024, 1400]} position="center 40%" decorative />
            <div class="roster-plates">
              {["001", "002", "003"].map((n, i) => (
                <span class={`roster-plate p${i}`}><span class="race-number">#EPOCH {n}</span><span class="rp-q">?</span></span>
              ))}
            </div>
          </div>
          <div class="roster-body">
            <p class="eyebrow">ROSTER</p>
            <h2 class="t-h2">The roster drops soon.</h2>
            <p class="body-l muted">We're picking the first Club racers and ambassadors now. Want on this page?</p>
            <div><Button href="/ride/apply" size="lg" arrow location="team-empty">Apply</Button></div>
          </div>
        </div>
      </RiderGrid>
    </div>
  </section>
</BaseLayout>

<style>
  .roster { display: grid; overflow: hidden; }
  @media (min-width: 1024px) { .roster { grid-template-columns: 1fr 1fr; } }
  .roster-media { position: relative; min-height: 380px; }
  .roster-media :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.1); }
  .roster-media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(14 15 12 / 0.75), rgb(14 15 12 / 0.1)); }
  .roster-plates { position: absolute; inset: auto 24px 28px 24px; z-index: 2; display: flex; gap: 12px; }
  .roster-plate { display: grid; gap: 6px; padding: 12px 14px; background: var(--color-bone); color: var(--color-carbon); border-radius: 6px; box-shadow: 0 18px 40px -16px rgb(0 0 0 / 0.8); }
  .roster-plate.p0 { transform: rotate(-5deg); } .roster-plate.p1 { transform: rotate(3deg) translateY(-10px); } .roster-plate.p2 { transform: rotate(-2deg); }
  .rp-q { font-family: var(--font-display); font-weight: 900; font-stretch: 125%; font-size: 2.6rem; line-height: 0.9; color: var(--color-summit-ink); }
  .roster-body { display: grid; gap: 20px; align-content: center; padding: clamp(28px, 5vw, 64px); }
</style>
