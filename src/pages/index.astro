---
import BaseLayout from "../components/layout/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import SectionHead from "../components/sections/SectionHead.astro";
import DisciplinePanels from "../components/sections/DisciplinePanels.astro";
import Photo from "../components/sections/Photo.astro";
import PhoneMock from "../components/sections/PhoneMock.astro";
import EventList from "../components/sections/EventList.astro";
import StoryGrid from "../components/sections/StoryGrid.astro";
import RiderGrid from "../components/sections/RiderGrid.astro";
import Marquee from "../components/sections/Marquee.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import ElevationProfile from "../components/sections/ElevationProfile.astro";
import Button from "../components/ui/Button.astro";
import LinkArrow from "../components/ui/LinkArrow.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import Disclaimer from "../components/ui/Disclaimer.astro";
import PillarIcon from "../components/brand/PillarIcon.astro";
import ProductPacks from "../components/sections/ProductPacks.astro";
import Icon from "../components/ui/Icon.astro";
import { getCollection } from "astro:content";
import { SITE } from "../config/site";
const hasStories = (await getCollection("stories", (s) => !s.data.draft)).length > 0;
---
<BaseLayout lcp="mtbBlur"
  title="Epoch Cycling | Ride. Fuel. Optimize."
  description="The riding tribe from Epoch Health System. Group rides, jerseys, help with race entries, ride fuel and a free app. Mountain bike first. Gravel and road next."
  overlayHeader
>
  <!-- 5.1.1 Hero -->
  <PageHero img="mtbBlur" eyebrow="EPOCH CYCLING · MTB / GRAVEL / ROAD" size="full" position="35% center" dust speed class="hero-home">
    <h1 class="t-display hero-h1 reveal">Now is your <span class="text-summit">time.</span></h1>
    <dl class="def reveal reveal-d1">
      <dt class="def-head"><dfn class="def-word">epoch</dfn> <span class="def-ipa" aria-hidden="true">/<span class="def-stress">ˈ</span>epək/</span><span class="sr-only">, pronounced EP-uck,</span> <span class="def-pos">noun</span></dt>
      <dd class="def-text">A fixed point in time so significant that everything is measured from it.</dd>
    </dl>
    <ul class="squares reveal reveal-d2" role="list" aria-label="The system">
      <li><a href="/ride" class="sq" style="--sq: var(--color-summit)" data-cta="Ride" data-cta-location="home-hero-squares"><span class="sq-top"><span class="race-number">01</span><PillarIcon name="ride" size={30} /></span><span class="sq-word">Ride</span><span class="sq-line">Group rides. Jerseys. The race deal.</span></a></li>
      <li><a href="/fuel" class="sq" style="--sq: var(--color-sage)" data-cta="Fuel" data-cta-location="home-hero-squares"><span class="sq-top"><span class="race-number">02</span><PillarIcon name="fuel" size={30} /></span><span class="sq-word">Fuel</span><span class="sq-line">Epoch Fuel. Epoch Salt. The guide.</span></a></li>
      <li><a href="/optimize" class="sq" style="--sq: var(--color-sky)" data-cta="Optimize" data-cta-location="home-hero-squares"><span class="sq-top"><span class="race-number">03</span><PillarIcon name="optimize" size={30} /></span><span class="sq-word">Optimize</span><span class="sq-line">The free app. Coaching. Labs.</span></a></li>
    </ul>
    <div class="hero-ctas reveal reveal-d3">
      <Button href="/join" size="lg" arrow location="home-hero">Join the Riders Club</Button>
      <Button href="/ride/apply" variant="outline" size="lg" location="home-hero">Apply to race</Button>
    </div>
    <ul class="chips-row reveal reveal-d3" role="list" aria-label="Why Epoch">
      <li><Icon name="check" size={16} />Free to join</li>
      <li><PillarIcon name="ride" size={16} />First race or fiftieth</li>
      <li><PillarIcon name="optimize" size={16} />Free app. Real depth.</li>
      <li><Icon name="shield" size={16} />Your data stays yours</li>
    </ul>
  </PageHero>

  <!-- 5.1.3 Riders Club band -->
  <section class="club-band" aria-labelledby="club-title">
    <div class="club-media photo">
      <Photo img="crewSingletrack" sizes="100vw" widths={[640, 1024, 1600]} position="center 40%" decorative />
    </div>
    <div class="club-shade" aria-hidden="true"></div>
    <div class="wrap club-inner">
      <Eyebrow class="club-eyebrow">THE EPOCH RIDERS CLUB</Eyebrow>
      <h2 id="club-title" class="club-title reveal"><span>Nobody</span> <span class="t-outline">gets fast</span> <span>alone.</span></h2>
      <p class="body-l club-body reveal reveal-d1">The club is the point. Show up to the ride. Race in the kit. Share the hard days. We've got your back.</p>
      <ul class="club-items" role="list">
        <li class="reveal"><span class="race-number">01</span><p class="t-h3">Group rides.</p><p>All levels. Nobody gets dropped without a regroup.</p></li>
        <li class="reveal reveal-d1"><span class="race-number">02</span><p class="t-h3">Jerseys.</p><p>Built to race. Made to wear to the taco truck after.</p></li>
        <li class="reveal reveal-d2"><span class="race-number">03</span><p class="t-h3">The race deal.</p><p>Fuel with Epoch. Race in the kit. We'll help cover your entry.</p></li>
      </ul>
      <p class="small club-fine">Entry support is for accepted Club racers, up to the club limit. See the <a href="/riders-club-terms" class="club-link">Riders Club terms</a>.</p>
      <div class="club-ctas">
        <Button href="/join" size="lg" arrow location="home-club">Join the club</Button>
        <a href="/ride/sponsorship" class="link-arrow club-arrow"><span>How the race deal works</span><span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 5.1.4 Disciplines -->
  <section class="section" aria-labelledby="disc-title">
    <div class="wrap-wide">
      <div class="wrap !px-0">
        <SectionHead eyebrow="DISCIPLINES" title="Dirt first. Then everything else." id="disc-title" />
      </div>
      <DisciplinePanels />
    </div>
  </section>

  <!-- Stats band (carried over from epochhealthsystem.com; honest counts only) -->
  <section class="stats" aria-label="Epoch Cycling in numbers">
    <ul class="wrap-wide stats-row" role="list">
      <li><span class="stat-n"><span data-countup="3">3</span></span><span class="stat-l">pillars. One system.</span></li>
      <li><span class="stat-n"><span data-countup="3">3</span></span><span class="stat-l">disciplines. One club.</span></li>
      <li><span class="stat-n">$0</span><span class="stat-l">to join the Riders Club.</span></li>
      <li><span class="stat-n">$0</span><span class="stat-l">for the app, with the advanced numbers.</span></li>
    </ul>
  </section>

  <!-- 5.1.5 Fuel teaser -->
  <section class="fuel-teaser on-moss" aria-labelledby="fuel-title">
    <div class="ft-media topo">
      <ProductPacks size="lg" class="reveal" />
    </div>
    <div class="ft-copy">
      <Eyebrow bar="var(--color-sage)" class="text-bone">FUEL</Eyebrow>
      <h2 id="fuel-title" class="t-h2 reveal">Fuel the ride.</h2>
      <p class="body-l reveal reveal-d1">Carbs for the long climb. Salt for the hot day. Labels you can actually read.</p>
      <div class="ft-cards">
        <a href="/fuel/epoch-fuel" class="ft-card reveal">
          <span class="tag">DROPPING SOON</span>
          <span class="t-h3">Epoch Fuel</span>
          <span class="small">Carbs and electrolytes in your bottle for rides over an hour.*</span>
          <PillarIcon name="fuel" size={40} class="ft-icon" />
        </a>
        <a href="/fuel/epoch-salt" class="ft-card reveal reveal-d1">
          <span class="tag">DROPPING SOON</span>
          <span class="t-h3">Epoch Salt</span>
          <span class="small">Electrolytes to replace what you sweat out.*</span>
          <span class="ft-salt" aria-hidden="true">Na K Mg</span>
        </a>
      </div>
      <div class="flex flex-wrap items-center gap-5">
        <Button href="/join?interest=fuel" variant="signal" arrow location="home-fuel">Get first access</Button>
        <LinkArrow href="/fuel/guide" accent="var(--color-sage)">How to fuel a ride</LinkArrow>
      </div>
      <Disclaimer variant="fda" class="ft-fine" />
    </div>
  </section>

  <!-- 5.1.6 Optimize teaser -->
  <section class="section opt-teaser" aria-labelledby="opt-title">
    <ElevationProfile class="opt-profile" color="var(--color-sky)" />
    <div class="wrap opt-grid">
      <div class="opt-copy">
        <Eyebrow bar="var(--color-sky)">OPTIMIZE</Eyebrow>
        <h2 id="opt-title" class="t-h2 reveal">Know when to send it. <span class="text-sky">Know when to rest.</span></h2>
        <p class="body-l muted reveal reveal-d1">The free Epoch app pulls in your rides, sleep and recovery, and tells you what they mean. Training load, recovery, readiness, all with the numbers behind them. Add a coach when you want one.</p>
        <div class="flex flex-wrap items-center gap-5 reveal reveal-d2">
          <Button href="/optimize#app" variant="sky" arrow location="home-optimize">Get the app free</Button>
          <LinkArrow href="/optimize" accent="var(--color-sky)">See what's inside</LinkArrow>
        </div>
      </div>
      <PhoneMock class="reveal" />
    </div>
  </section>

  <!-- 5.1.7 Events -->
  <section class="section on-ridge topo" aria-labelledby="events-title">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHead eyebrow="ON THE CALENDAR" title="Come ride." id="events-title" />
      </div>
      <EventList limit={3} />
      <div class="mt-10"><Button href="/ride/events" variant="outline" arrow location="home-events">See all events</Button></div>
    </div>
  </section>

  <!-- 5.1.8 Stories (hidden if none published) -->
  {hasStories && (
    <section class="section" aria-labelledby="stories-title">
      <div class="wrap">
        <SectionHead eyebrow="STORIES" title="From the trail." id="stories-title" />
        <StoryGrid limit={3} />
        <div class="mt-10"><Button href="/stories" variant="outline" arrow location="home-stories">Read more stories</Button></div>
      </div>
    </section>
  )}

  <!-- 5.1.9 The crew (hidden while showRiders is false) -->
  {SITE.flags.showRiders && (
    <section class="section" aria-labelledby="crew-title">
      <div class="wrap">
        <SectionHead eyebrow="THE CREW" title="Riders first." id="crew-title" />
        <RiderGrid featured limit={4} />
      </div>
    </section>
  )}

  <!-- 5.1.10 Marquee -->
  <Marquee />

  <!-- 5.1.11 Closing CTA -->
  <CtaBand id="get" title="See you at the trailhead." sub="Join free. Get the app. Find a ride near you." img="trailheadSunset" position="center 70%">
    <Button href="/join" size="lg" arrow location="home-closing">Join the club</Button>
    <Button href="/ride/events" variant="outline" size="lg" location="home-closing">Find a ride</Button>
  </CtaBand>
</BaseLayout>

<style>
  .hero-h1 { max-width: 14ch; font-size: min(var(--text-display), 11.5vh); }
  /* Home hero carries more content than other heroes: trim its padding so it fits one laptop screen */
  @media (min-width: 768px) { :global(.hero-home .hero-content) { padding-top: 124px; padding-bottom: 104px; } }
  /* Dictionary definition under the slogan */
  .def { margin: 20px 0 0; padding-left: 18px; border-left: 3px solid var(--color-summit); max-width: 40rem; }
  .def-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; }
  .def-word { font-family: var(--font-display); font-weight: 800; font-stretch: 112%; font-style: normal; font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1; }
  .def-ipa { font-family: var(--font-mono); font-size: 1rem; color: var(--color-dust); }
  /* The stress mark isn't in our fonts: draw it from a proportional system font so mono spacing doesn't leave a gap */
  .def-stress { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; margin: 0 0.02em 0 0.04em; }
  .def-pos { font-family: var(--font-body); font-style: italic; font-size: 1rem; color: var(--color-summit); }
  .def-text { margin: 8px 0 0; font-size: var(--text-body-l); line-height: 1.45; color: #ece7dc; max-width: 38ch; }
  /* Three squares: Ride, Fuel, Optimize */
  /* container-type lets the square labels scale with the squares, so OPTIMIZE always fits */
  .squares { container-type: inline-size; list-style: none; padding: 0; margin: 22px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; max-width: 600px; }
  .sq { position: relative; display: flex; flex-direction: column; aspect-ratio: 1 / 1; padding: clamp(10px, 1.6vw, 18px); border-radius: 10px; text-decoration: none; color: var(--color-bone); background: rgb(14 15 12 / 0.62); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); border: 1px solid rgb(242 238 230 / 0.14); border-top: 3px solid var(--sq); transition: transform 240ms var(--ease), background 240ms var(--ease), border-color 240ms var(--ease); overflow: hidden; }
  .sq::after { content: ""; position: absolute; inset: auto 0 0 0; height: 3px; background: var(--sq); transform: scaleX(0); transform-origin: left; transition: transform 320ms var(--ease); }
  .sq:hover, .sq:focus-visible { transform: translateY(-4px); background: rgb(14 15 12 / 0.82); border-color: rgb(242 238 230 / 0.28); border-top-color: var(--sq); }
  .sq:hover::after, .sq:focus-visible::after { transform: scaleX(1); }
  .sq-top { display: flex; justify-content: space-between; align-items: center; color: var(--sq); }
  .sq-top .race-number { color: var(--color-dust); }
  .sq-word { margin-top: auto; font-family: var(--font-display); font-weight: 900; font-stretch: 112%; text-transform: uppercase; font-size: clamp(0.6rem, 4cqi, 1.8rem); line-height: 1; white-space: nowrap; }
  .sq-line { margin-top: 8px; font-size: 0.875rem; line-height: 1.35; color: #d9d4c8; min-height: 2.7em; }
  @media (max-width: 639px) {
    .sq { padding: 10px; }
    .sq-top :global(svg) { width: 24px; height: 24px; }
    .sq-line { display: none; }
  }
  @media (max-width: 399px) {
    .sq { padding: 8px; }
  }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 16px 22px; margin-top: 24px; }
  /* Short laptop screens: smaller squares so the buttons stay above the fold (after the base rule on purpose) */
  @media (min-width: 768px) and (max-height: 820px) { .squares { max-width: 500px; } }
  /* Trust chips (carried over from epochhealthsystem.com) */
  .chips-row { list-style: none; padding: 0; margin: 18px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips-row li { display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 999px; border: 1px solid rgb(242 238 230 / 0.16); background: rgb(14 15 12 / 0.55); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); font-size: 0.875rem; color: #e7e2d6; }
  .chips-row :global(svg) { color: var(--color-dust); flex: none; }

  /* Riders Club band: solid black behind the text, fading to Summit blue with a blue-toned photo on the right */
  .club-band { position: relative; isolation: isolate; overflow: hidden; color: var(--color-bone); background: var(--color-carbon); }
  .club-media { position: absolute; inset: 0; z-index: -2; background: var(--color-summit); isolation: isolate; -webkit-mask-image: linear-gradient(100deg, transparent 30%, rgb(0 0 0 / 0.55) 58%, #000 88%); mask-image: linear-gradient(100deg, transparent 30%, rgb(0 0 0 / 0.55) 58%, #000 88%); }
  .club-media :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.25) brightness(1.05); mix-blend-mode: multiply; opacity: 0.9; }
  .club-shade { position: absolute; inset: 0; z-index: -1; background: radial-gradient(ellipse at 100% 50%, rgb(45 140 255 / 0.25), transparent 60%); pointer-events: none; }
  .club-inner { padding-block: clamp(80px, 12vw, 170px); display: grid; gap: 26px; }
  .club-title { font-family: var(--font-display); font-weight: 900; font-stretch: 125%; text-transform: uppercase; font-size: clamp(3rem, 8.5vw, 8rem); line-height: 0.86; letter-spacing: -0.02em; max-width: 12ch; }
  .club-title span { display: block; }
  .club-title .t-outline { --outline-color: var(--color-summit); -webkit-text-stroke-width: 2.5px; }
  .club-body { max-width: 44ch; color: #e7e2d6; }
  .club-items { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 14px; }
  @media (min-width: 900px) { .club-items { grid-template-columns: repeat(3, 1fr); } }
  .club-items li { background: rgb(14 15 12 / 0.72); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid rgb(242 238 230 / 0.12); border-top: 3px solid var(--color-summit); color: var(--color-bone); padding: 24px; border-radius: var(--radius-md); display: grid; gap: 8px; align-content: start; }
  .club-items .race-number { color: var(--color-summit); }
  .club-fine { color: var(--color-dust); }
  .club-link { color: var(--color-bone); text-decoration: underline; text-underline-offset: 3px; }
  .club-ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 26px; }
  .club-arrow { color: var(--color-bone) !important; }
  .club-arrow .arr { color: var(--color-summit); }
  @media (max-width: 899px) {
    /* Phones: blue photo at the top, fading down into black before the text starts */
    .club-media { inset: 0 0 auto 0; height: 340px; -webkit-mask-image: linear-gradient(180deg, #000 35%, transparent 100%); mask-image: linear-gradient(180deg, #000 35%, transparent 100%); }
    .club-shade { display: none; }
    .club-inner { padding-top: 220px; }
  }

  .stats { border-block: 1px solid var(--color-slate); background: var(--color-ridge); }
  .stats-row { list-style: none; margin: 0 auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) { .stats-row { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .stats-row li { display: grid; gap: 10px; padding: clamp(24px, 4vw, 44px) clamp(16px, 2.5vw, 32px); border-left: 1px solid var(--color-slate); }
  .stats-row li:first-child, .stats-row li:nth-child(3) { border-left: 0; }
  @media (min-width: 900px) { .stats-row li:nth-child(3) { border-left: 1px solid var(--color-slate); } }
  .stat-n { font-family: var(--font-mono); font-weight: 500; font-size: clamp(2.75rem, 6vw, 5rem); line-height: 1; color: var(--color-bone); }
  .stat-l { color: var(--color-dust); font-size: 0.975rem; }
  .fuel-teaser { display: grid; }
  @media (min-width: 1024px) { .fuel-teaser { grid-template-columns: 1fr 1fr; } }
  .ft-media { min-height: 420px; display: grid; place-items: center; padding-inline: 20px; background: radial-gradient(ellipse at 50% 45%, #4a5a40, #2b3526 70%); }
  .ft-copy { display: grid; gap: 22px; align-content: center; padding: clamp(48px, 7vw, 110px) clamp(20px, 5vw, 80px); position: relative; }
  .ft-cards { display: grid; gap: 14px; }
  @media (min-width: 640px) { .ft-cards { grid-template-columns: 1fr 1fr; } }
  .ft-card { position: relative; overflow: hidden; display: grid; gap: 10px; align-content: start; justify-items: start; padding: 22px; min-height: 200px; border-radius: var(--radius-md); background: rgb(14 15 12 / 0.55); border: 1px solid rgb(242 238 230 / 0.12); text-decoration: none; transition: transform 260ms var(--ease), background 260ms var(--ease); }
  .ft-card:hover { transform: translateY(-4px); background: rgb(14 15 12 / 0.75); }
  :global(.ft-icon) { position: absolute; right: 16px; bottom: 16px; color: var(--color-sage); }
  .ft-salt { position: absolute; right: 16px; bottom: 14px; font-family: var(--font-mono); color: var(--color-sage); font-size: 0.9rem; letter-spacing: 0.1em; }
  :global(.ft-fine) { color: #cfd3c4 !important; }

  .opt-teaser { overflow: hidden; }
  :global(.opt-profile) { position: absolute; left: 0; right: 0; bottom: 0; height: 45%; opacity: 0.6; pointer-events: none; }
  .opt-grid { position: relative; display: grid; gap: 56px; align-items: center; }
  @media (min-width: 1024px) { .opt-grid { grid-template-columns: 1.15fr 1fr; } }
  .opt-copy { display: grid; gap: 22px; }
</style>
