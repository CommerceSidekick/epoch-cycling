---
import { getCollection } from "astro:content";
import ProductPage from "../../components/sections/ProductPage.astro";

const META: Record<string, { title: string; description: string }> = {
  "epoch-endurance": {
    title: "Epoch Endurance | Custom Endurance Mix | Epoch Cycling",
    description: "A custom endurance mix with potassium, magnesium and OKG. Not another electrolyte drink. Coming soon, every ingredient on the label.",
  },
  "epoch-fuel": {
    title: "Epoch Fuel | Performance and Recovery Support | Epoch Cycling",
    description: "Performance and recovery support for training days. Every ingredient and amount listed. No proprietary blends. Coming soon.",
  },
  "epoch-edge": {
    title: "Epoch Edge | Focus and Mental Performance | Epoch Cycling",
    description: "Support for focus and mental performance, in training, at work and on race day. Coming soon, every ingredient on the label.",
  },
};

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}
const { product } = Astro.props;
const meta = META[product.id] ?? { title: `${product.data.name} | Epoch Cycling`, description: product.data.oneLiner.replace(/\*$/, "") };
---
<ProductPage product={product} metaTitle={meta.title} metaDescription={meta.description} />
