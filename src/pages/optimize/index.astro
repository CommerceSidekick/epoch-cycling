---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import Photo from "../../components/sections/Photo.astro";
import PhoneMock from "../../components/sections/PhoneMock.astro";
import SectionNav from "../../components/sections/SectionNav.astro";
import HandoffDivider from "../../components/sections/HandoffDivider.astro";
import HandoffBlock from "../../components/sections/HandoffBlock.astro";
import Snippet from "../../components/sections/Snippet.astro";
import CtaBand from "../../components/sections/CtaBand.astro";
import ElevationProfile from "../../components/sections/ElevationProfile.astro";
import Button from "../../components/ui/Button.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import ExternalLink from "../../components/ui/ExternalLink.astro";
import LinkArrow from "../../components/ui/LinkArrow.astro";
import Icon from "../../components/ui/Icon.astro";
import PillarIcon from "../../components/brand/PillarIcon.astro";
import { snippetBlock } from "../../lib/snippets";
import { SITE } from "../../config/site";
import { BRAND } from "../../config/brand";
import { INTEGRATIONS } from "../../config/integrations";

const f = SITE.appFeatures;
const features = [
  { key: "trainingLoad", live: f.trainingLoad.live, title: "Training load.", body: "How hard you've been riding, and if you're building fitness or digging a hole." },
  { key: "recovery", live: f.recovery.live, title: "Recovery.", body: "Sleep, HRV and resting heart rate side by side, so you know when to push." },
  { key: "readiness", live: f.readiness.live, title: "Readiness.", body: "A daily read on how ready you are, with every input shown: HRV, resting heart rate, sleep and recent load. No mystery number." },
  { key: "rideData", live: f.rideData.live, title: "Ride data.", body: "Time, distance, climbing, heart rate, and power if you've got a meter. Every ride in one place." },
  { key: "trends", live: f.trends.live, title: "Trends.", body: "Weeks and months, not just today. See what's actually changing." },
  { key: "fuelLog", live: f.fuelLog.live, title: "Fuel log.", body: "What you ate and drank, next to how you rode." },
].filter((x) => x.live);
const integrations = INTEGRATIONS.filter((i) => !i.flag || SITE.flags[i.flag]);
const liveInt = integrations.filter((i) => i.status === "live");
const plannedInt = integrations.filter((i) => i.status === "planned");
const antidoping = await snippetBlock("antidoping-full", "optimize");
const markers = [
  { t: "Iron and blood.", b: "How well you carry oxygen. Endurance riders keep an eye on this one." },
  { t: "Fuel and metabolism.", b: "How you're handling what you eat." },
  { t: "Vitamin D and the basics.", b: "The everyday stuff that's easy to miss." },
  { t: "Heart and lipids.", b: "The long game." },
];
---
<BaseLayout lcp="mtbBermRoost" lcpWidths={[640, 1024, 1600]}
  title="Optimize | The Epoch Program for Riders | Epoch Cycling"
  description="The Epoch program for riders: a free app that reads your training and recovery, fitness and lifestyle coaching, and physician-led Personalized Health on Epoch Health System."
  breadcrumbs={[{ name: "Optimize", path: "/optimize" }]}
  overlayHeader
>
  <!-- 5.13.1 Hero -->
  <section class="opt-hero" aria-labelledby="opt-h1">
    <div class="oh-media photo">
      <Photo img="mtbBermRoost" eager sizes="100vw" widths={[640, 1024, 1600]} position="50% 45%" decorative />
    </div>
    <div class="oh-shade" aria-hidden="true"></div>
    <ElevationProfile class="oh-profile" color="var(--color-sky)" />
    <div class="wrap oh-grid">
      <div class="oh-copy">
        <Eyebrow bar="var(--color-sky)" class="text-bone">PILLAR 03 · OPTIMIZE</Eyebrow>
        <h1 id="opt-h1" class="t-display reveal oh-h1">Know when to send it. <span class="text-sky">Know when to rest.</span></h1>
        <p class="body-l reveal reveal-d1 oh-sub">Optimize is the Epoch program. The free app reads your rides, sleep and recovery. Fitness and lifestyle coaching turns it into a plan. Physician-led Personalized Health goes deeper when you're ready.</p>
        <div class="flex flex-wrap gap-4 reveal reveal-d2">
          <Button href="#app" variant="sky" size="lg" arrow location="optimize-hero">Get the app free</Button>
          <Button href="#coaching" variant="outline" size="lg" location="optimize-hero">See coaching</Button>
        </div>
        <ul class="oh-services reveal reveal-d3" role="list">
          <li><span class="mono">01</span> {BRAND.services.app}</li>
          <li><span class="mono">02</span> {BRAND.services.coaching}</li>
          <li><span class="mono">03</span> {BRAND.services.health}</li>
        </ul>
      </div>
      <PhoneMock class="oh-phone" />
    </div>
  </section>

  <!-- 5.13.2 Section nav -->
  <SectionNav />

  <!-- 5.13.3 The free app -->
  <section id="app" class="section topo" aria-labelledby="app-title" data-section="app">
    <div class="wrap">
      <div class="app-head">
        <Eyebrow bar="var(--color-sky)">THE APP · {BRAND.services.app.toUpperCase()}</Eyebrow>
        <h2 id="app-title" class="t-h2 reveal">The free Epoch app. Built for riders.</h2>
        <p class="body-l muted measure reveal reveal-d1">Every ride, every night of sleep, every recovery number, in one place. Explained in plain words. Free, with the advanced numbers included.</p>
      </div>
      <ul class="feat-grid" role="list">
        {features.map((x, i) => (
          <li class={`feat card reveal reveal-d${i % 3}`}>
            <span class="feat-n mono">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="t-h3">{x.title}</h3>
            <p class="muted">{x.body}</p>
          </li>
        ))}
      </ul>
      <p class="house-line reveal">No rings. No streaks. <span class="text-sky">Just your numbers, explained.</span></p>

      <div class="int-wrap">
        <h3 class="t-h3">Works with</h3>
        <ul class="int-grid" role="list">
          {liveInt.map((i) => (
            <li class="int"><span class="int-name">{i.name}</span><span class="int-brings small muted">{i.brings}</span><span class="tag tag-outline">LIVE</span></li>
          ))}
          {plannedInt.map((i) => (
            <li class="int int-planned"><span class="int-name">{i.name}</span><span class="int-brings small muted">{i.brings}</span><span class="tag">PLANNED</span></li>
          ))}
        </ul>
        <p class="small muted mt-4">Planned means planned. We'll say when it's live. <a href="/contact?topic=integration" class="link">Request an integration</a></p>
      </div>

      <div class="get-it card">
        <div class="grid gap-3">
          <p class="t-h3">Get it.</p>
          <div class="flex flex-wrap items-center gap-4">
            {SITE.appStoreUrl && <a href={SITE.appStoreUrl} class="btn btn-bone btn-sm" target="_blank" rel="noopener">App Store<span class="sr-only"> (opens in a new tab)</span></a>}
            {SITE.playStoreUrl && <a href={SITE.playStoreUrl} class="btn btn-bone btn-sm" target="_blank" rel="noopener">Google Play<span class="sr-only"> (opens in a new tab)</span></a>}
            {SITE.flags.appStatus === "waitlist" && <Button href="/join?interest=app" variant="sky" arrow location="optimize-app">Get early access</Button>}
            <ExternalLink href={SITE.appUrl} campaign="optimize_app_signin" class="link-arrow">Already in? Sign in</ExternalLink>
          </div>
          <p class="small muted"><ExternalLink href={`${SITE.masterUrl}/system#train`} campaign="optimize_app" class="link" arrow={false}>The Epoch app is part of Epoch Health System.</ExternalLink></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5.13.4 Coaching -->
  <section id="coaching" class="section on-ridge" aria-labelledby="coach-title" data-section="coaching">
    <div class="wrap coach-grid">
      <div class="grid gap-5 content-start">
        <Eyebrow bar="var(--color-sky)">COACHING</Eyebrow>
        <h2 id="coach-title" class="t-h2 reveal">Fitness and lifestyle coaching.</h2>
        <p class="body-l muted reveal reveal-d1">Training, strength, nutrition, sleep and recovery, built around your riding and your week. Your plan works from your own data, with weekly check-ins and straight answers when you ask.</p>
        <ul class="coach-list" role="list">
          <li><Icon name="check" size={20} class="text-sky" />A plan that adjusts when your week falls apart</li>
          <li><Icon name="check" size={20} class="text-sky" />Built around the races on your calendar</li>
          <li><Icon name="check" size={20} class="text-sky" />Weekly check-ins and goal tracking</li>
          <li><Icon name="check" size={20} class="text-sky" />Strength and mobility for the bike you ride</li>
        </ul>
        <div class="flex flex-wrap items-center gap-4">
          <ExternalLink href={`${SITE.appUrl}?plan=coach`} campaign="optimize_coach" class="btn btn-sky" arrow={false}>Get Coach <Icon name="arrow-up-right" size={18} class="arr" /></ExternalLink>
          <span class="mono price">{SITE.prices.coach}{SITE.prices.period}</span>
        </div>
      </div>
      <PhoneMock variant="coach" class="reveal" />
    </div>
  </section>

  <!-- 5.13.5 Labs -->
  <section id="labs" class="section" aria-labelledby="labs-title" data-section="labs">
    <div class="wrap">
      <div class="grid gap-5 max-w-[860px]">
        <Eyebrow bar="var(--color-sky)">LABS</Eyebrow>
        <h2 id="labs-title" class="t-h2 reveal">Look under the hood.</h2>
        <p class="body-l muted reveal reveal-d1">Training data tells you a lot. Blood work tells you more. Upload lab results you already have and see your markers next to your training, over time.</p>
      </div>
      <ul class="marker-grid" role="list">
        {markers.map((m, i) => (
          <li class={`marker reveal reveal-d${i}`}>
            <PillarIcon name="optimize" size={26} class="text-sky" />
            <p class="t-h4">{m.t}</p>
            <p class="small muted">{m.b}</p>
          </li>
        ))}
      </ul>
      <Snippet id="labs-smallprint" class="fine mt-8 measure" />
    </div>
  </section>

  <!-- 5.13.6 Divider + handoff block (the program, ending in Personalized Health) -->
  <HandoffDivider />
  <HandoffBlock />

  <!-- 5.13.7 Anti-doping callout -->
  <section class="section-tight" aria-label="Anti-doping">
    <div class="wrap">
      <aside class="callout reveal">
        <h3 class="t-h3 mb-3">{antidoping.title}</h3>
        <p class="measure">{antidoping.body}</p>
        <ul class="ad-links" role="list">
          <li><a href="https://www.wada-ama.org/en/prohibited-list" target="_blank" rel="noopener" class="link" data-outbound>WADA Prohibited List ↗<span class="sr-only"> (opens in a new tab)</span></a></li>
          <li><a href="https://www.globaldro.com" target="_blank" rel="noopener" class="link" data-outbound>Global DRO ↗<span class="sr-only"> (opens in a new tab)</span></a></li>
          <li><a href="https://www.usada.org/athletes/substances/therapeutic-use-exemption/" target="_blank" rel="noopener" class="link" data-outbound>USADA TUE info ↗<span class="sr-only"> (opens in a new tab)</span></a></li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- 5.13.8 CTA band -->
  <CtaBand title="Better every season." img="roadDawn" position="center 60%">
    <Button href="#app" variant="sky" size="lg" arrow location="optimize-cta">Get the app free</Button>
    <Button href="/join" variant="outline" size="lg" location="optimize-cta">Join the club</Button>
  </CtaBand>
  <div class="wrap pb-10 flex gap-6 flex-wrap">
    <LinkArrow href="/ride">Ride: the Riders Club</LinkArrow>
    <LinkArrow href="/fuel" accent="var(--color-sage)">Fuel: Endurance, Fuel and Edge</LinkArrow>
    <LinkArrow href="/mtb">Epoch MTB</LinkArrow>
  </div>
</BaseLayout>

<style>
  .opt-hero { position: relative; isolation: isolate; overflow: hidden; min-height: 92svh; display: flex; align-items: center; }
  .oh-media { position: absolute; inset: 0; z-index: -3; }
  .oh-media :global(img) { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.6) contrast(1.1); }
  .oh-shade { position: absolute; inset: 0; z-index: -2; background: linear-gradient(90deg, rgb(14 15 12 / 0.95) 0%, rgb(14 15 12 / 0.75) 45%, rgb(14 15 12 / 0.45) 100%), linear-gradient(0deg, var(--color-carbon) 0%, transparent 35%); }
  :global(.oh-profile) { position: absolute; left: 0; right: 0; bottom: 0; height: 40%; z-index: -1; opacity: 0.55; }
  .oh-grid { display: grid; gap: 48px; align-items: center; padding-top: 150px; padding-bottom: 90px; }
  @media (min-width: 1024px) { .oh-grid { grid-template-columns: 1.25fr 0.75fr; } }
  .oh-copy { display: grid; gap: 26px; }
  .oh-h1 { font-size: clamp(2.75rem, 6.2vw, 6rem); max-width: 13ch; }
  .oh-sub { max-width: 46ch; color: #e4dfd3; }
  .oh-services { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .oh-services li { display: inline-flex; gap: 10px; align-items: center; padding: 10px 14px; border: 1px solid rgb(143 184 201 / 0.4); border-radius: 999px; font-weight: 600; font-size: 0.9375rem; background: rgb(14 15 12 / 0.5); }
  .oh-services .mono { color: var(--color-sky); font-size: 0.8125rem; }
  .app-head { display: grid; gap: 20px; max-width: 900px; margin-bottom: 48px; }
  .feat-grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .feat { padding: 28px; display: grid; gap: 10px; align-content: start; border-top: 3px solid var(--color-sky); }
  .feat-n { color: var(--color-sky); font-size: 0.8125rem; }
  .house-line { font-family: var(--font-display); font-weight: 900; font-stretch: 125%; text-transform: uppercase; font-size: clamp(1.75rem, 4.2vw, 3.6rem); line-height: 0.95; margin: clamp(48px, 7vw, 88px) 0; max-width: 18ch; }
  .int-wrap { display: grid; gap: 18px; }
  .int-grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .int { display: grid; gap: 6px; justify-items: start; padding: 16px 18px; border: 1px solid var(--color-slate); border-radius: 10px; background: var(--color-ridge); }
  .int-name { font-weight: 600; }
  .int-planned { border-style: dashed; background: transparent; }
  .get-it { margin-top: 40px; padding: 28px; border-left: 4px solid var(--color-sky); }
  .coach-grid { display: grid; gap: 56px; align-items: center; }
  @media (min-width: 1024px) { .coach-grid { grid-template-columns: 1.2fr 0.8fr; } }
  .coach-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .coach-list li { display: flex; gap: 12px; align-items: flex-start; font-weight: 500; }
  .price { color: var(--color-sage); }
  .marker-grid { list-style: none; padding: 0; margin: 44px 0 0; display: grid; gap: 14px; }
  @media (min-width: 768px) { .marker-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .marker-grid { grid-template-columns: repeat(4, 1fr); } }
  .marker { display: grid; gap: 10px; align-content: start; padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--color-slate); border-top: 3px solid var(--color-sky); background: linear-gradient(180deg, rgb(143 184 201 / 0.08), transparent 70%); }
  .section-tight { padding-block: clamp(40px, 6vw, 72px); }
  .ad-links { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-wrap: wrap; gap: 10px 24px; }
</style>
