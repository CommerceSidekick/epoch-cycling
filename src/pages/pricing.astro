---
// Pricing: one page for everything a rider can pay for (or not). Layout follows the
// Epoch Health System pricing page so both sites read the same. No medical prices on this domain.
import BaseLayout from "../components/layout/BaseLayout.astro";
import PageHeader from "../components/sections/PageHeader.astro";
import SectionHead from "../components/sections/SectionHead.astro";
import FaqAccordion from "../components/sections/FaqAccordion.astro";
import Snippet from "../components/sections/Snippet.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import Disclaimer from "../components/ui/Disclaimer.astro";
import PillarIcon from "../components/brand/PillarIcon.astro";
import { snippetBlock } from "../lib/snippets";
import { withUtm } from "../lib/utm";
import { faqById } from "../content/faq";
import { SITE } from "../config/site";
import { BRAND } from "../config/brand";

const P = SITE.prices;
const waitlist = SITE.flags.appStatus === "waitlist";
const appLink = (plan: string) => (waitlist ? `/join?interest=app` : withUtm(`${SITE.appUrl}?plan=${plan}`, `pricing_${plan}`));
const appCta = waitlist ? "Get early access" : null;

type Plan = { name: string; who: string; price: string; per?: string; note?: string; items: string[]; cta: string; href: string; featured?: boolean; accent: string };

// The club: free to join, racer and ambassador spots by application.
const club: Plan[] = [
  { name: "Member", who: "Anyone. Every level.", price: P.free, items: ["Group rides and events near you", "First dibs on jersey and fuel drops", "The crew, inside the Epoch app"], cta: "Join free", href: "/join", accent: "var(--color-summit)" },
  { name: "Club racer", who: "Racers of any level.", price: "By application", items: ["Everything members get", "Help with race entries, up to the club limit", "Club racer jersey with the Signal cuff stripe"], cta: "Apply to race", href: "/ride/apply?type=racer", featured: true, accent: "var(--color-sage)" },
  { name: "Ambassador", who: "Riders who bring people together.", price: "By application", items: ["Host rides and build the local crew", "Kit and fuel for the rides you host", "Ambassador code on Fuel and jerseys"], cta: "Apply to be an ambassador", href: "/ride/apply?type=ambassador", accent: "var(--color-summit)" },
];

// The app: same three plans as epochhealthsystem.com.
const app: Plan[] = [
  { name: "Free", who: "For every rider.", price: P.free, items: ["Training load, recovery and trends", "Every ride in one place", "Connects the sources on the app page", "The crew, inside the app"], cta: appCta ?? "Get the app", href: waitlist ? "/join?interest=app" : "/optimize#app", accent: "var(--color-sky)" },
  { name: "Plus", who: "Guidance on top of your data.", price: P.plus, per: P.period, items: ["Everything in Free", "Personalized recommendations", "Deeper reports and exports", "Member pricing on Epoch supplements"], cta: appCta ?? "Go Plus", href: appLink("plus"), accent: "var(--color-sky)" },
  { name: "Coach", who: "Fitness and lifestyle coaching.", price: P.coach, per: P.period, items: ["Everything in Plus", "Training, strength, nutrition, sleep and recovery", "A plan built around your riding and your week", "Weekly check-ins and goal tracking"], cta: appCta ?? "Get Coach", href: appLink("coach"), featured: true, accent: "var(--color-sky)" },
];

const gear = [
  { name: "Epoch Endurance", line: "A custom endurance mix for long rides and hard training days.*", href: "/fuel/epoch-endurance", tag: "COMING SOON", icon: "fuel" as const },
  { name: "Epoch Fuel", line: "Performance and recovery support for training days.*", href: "/fuel/epoch-fuel", tag: "COMING SOON", icon: "fuel" as const },
  { name: "Epoch Edge", line: "Support for focus and mental performance.*", href: "/fuel/epoch-edge", tag: "COMING SOON", icon: "fuel" as const },
  { name: "Jerseys", line: "EPOCH on the chest. Your discipline on the sleeve.", href: "/ride#kit", tag: "COMING SOON", icon: "ride" as const },
];

const th = await snippetBlock("pricing-total-health", "heading");
const faq = ["cost-to-join", "is-the-app-free", "how-race-deal-works", "which-races-count"].map(faqById);
---
<BaseLayout
  title="Pricing | Free Club, Free App, Coaching | Epoch Cycling"
  description="The Epoch Riders Club is free. The Epoch app is free. Add Plus or Coach when you want more. Supplements and jerseys are priced at launch."
  breadcrumbs={[{ name: "Pricing", path: "/pricing" }]}
>
  <PageHeader eyebrow="PRICING" ghost="$0">
    <h1 class="t-display pr-h1">Start free. <span class="text-summit">Go as far as you want.</span></h1>
    <p class="body-l muted measure">The club is free. The app is free. Pay only for the extras you want.</p>
  </PageHeader>

  <!-- The club -->
  <section class="section" aria-labelledby="club-title">
    <div class="wrap">
      <SectionHead eyebrow="01 · THE RIDERS CLUB" title="The crew costs nothing." id="club-title" intro="Group rides and the club are open to everyone. Club racer and ambassador spots are by application." />
      <ul class="plans" role="list">
        {club.map((p, i) => (
          <li class={`plan card reveal reveal-d${i} ${p.featured ? "is-featured" : ""}`} style={`--acc:${p.accent}`}>
            {p.featured && <span class="tag plan-flag">FOR RACERS</span>}
            <h3 class="t-h3">{p.name}</h3>
            <p class="small muted">{p.who}</p>
            <p class={`plan-price ${p.price.startsWith("$") ? "" : "is-text"}`}>{p.price}{p.per && <span class="plan-per">{p.per}</span>}</p>
            <ul class="plan-items" role="list">{p.items.map((x) => <li><Icon name="check" size={18} />{x}</li>)}</ul>
            <a href={p.href} class={`btn ${p.featured ? "btn-signal" : "btn-outline"} plan-cta`}>{p.cta}</a>
          </li>
        ))}
      </ul>
      <p class="fine mt-6">Club racer and ambassador spots are limited each season. Entry support is up to the club limit. Full rules in the <a href="/riders-club-terms" class="link">Riders Club terms</a>.</p>
    </div>
  </section>

  <!-- The app -->
  <section class="section on-ridge topo" aria-labelledby="app-title">
    <div class="wrap">
      <SectionHead eyebrow="02 · THE EPOCH APP" title="Free app. Real depth." id="app-title" intro="Everyone gets the full free app. Upgrade when you want more." bar="var(--color-sky)" />
      <p class="mono small muted -mt-6 mb-8">Plans billed yearly. Cancel any time.</p>
      <ul class="plans" role="list">
        {app.map((p, i) => (
          <li class={`plan card reveal reveal-d${i} ${p.featured ? "is-featured" : ""}`} style={`--acc:${p.accent}`}>
            {p.featured && <span class="tag plan-flag">MOST POPULAR</span>}
            <h3 class="t-h3">{p.name}</h3>
            <p class="small muted">{p.who}</p>
            <p class="plan-price">{p.price}{p.per && <span class="plan-per">{p.per}</span>}</p>
            <ul class="plan-items" role="list">{p.items.map((x) => <li><Icon name="check" size={18} />{x}</li>)}</ul>
            {p.note && <p class="fine">{p.note}</p>}
            <a href={p.href} class={`btn ${p.featured ? "btn-sky" : "btn-outline"} plan-cta`} {...(p.href.startsWith("http") ? { rel: "noopener", "data-outbound": "" } : {})}>{p.cta}</a>
          </li>
        ))}
      </ul>
      {waitlist && <p class="fine mt-6">The app is in early access. Join the list and we'll tell you when your plan opens.</p>}
    </div>
  </section>

  <!-- Fuel and jerseys -->
  <section class="section" aria-labelledby="gear-title">
    <div class="wrap">
      <SectionHead eyebrow="03 · FUEL AND JERSEYS" title="Priced at launch." id="gear-title" intro="Supplements and jerseys get real prices when they ship. Plus members get member pricing on Epoch supplements." bar="var(--color-sage)" />
      <ul class="gear" role="list">
        {gear.map((g, i) => (
          <li class={`gear-card card card-hover reveal reveal-d${i}`}>
            <div class="flex items-center justify-between gap-3"><span class="tag">{g.tag}</span><PillarIcon name={g.icon} size={30} class="text-sage" /></div>
            <h3 class="t-h3"><a href={g.href} class="gear-link">{g.name}</a></h3>
            <p class="small muted">{g.line}</p>
            <p class="mono small gear-price">Price at launch</p>
          </li>
        ))}
      </ul>
      <div class="mt-8 flex flex-wrap items-center gap-5">
        <Button href="/join?interest=fuel,kits" variant="signal" arrow location="pricing-gear">Get first access</Button>
      </div>
      <Disclaimer variant="fda" class="mt-6" />
    </div>
  </section>

  <!-- Medical programs: never priced on this domain -->
  <section class="section on-light" aria-labelledby="th-title">
    <div class="wrap th-grid">
      <div class="grid gap-4">
        <p class="eyebrow">04 · {BRAND.program.toUpperCase()}</p>
        <h2 id="th-title" class="t-h2">{th.title}</h2>
        <p class="body-l th-body">{th.body}</p>
        <div class="flex flex-wrap items-center gap-5 mt-2">
          <a href="/optimize/medical" class="btn btn-dark">Explore {BRAND.program} <Icon name="arrow-up-right" size={18} class="arr" /></a>
          <span class="small">You'll leave Epoch Cycling for Epoch Health System.</span>
        </div>
      </div>
      <Snippet id="separation-line" class="fine th-sep" />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" aria-labelledby="pfaq-title">
    <div class="wrap pfaq">
      <div class="grid gap-5 content-start">
        <h2 id="pfaq-title" class="t-h2">Questions. Answered.</h2>
        <a href="/faq" class="link-arrow"><span>All questions</span><Icon name="arrow-right" size={18} class="arr" /></a>
      </div>
      <FaqAccordion entries={faq} />
    </div>
  </section>
</BaseLayout>

<style>
  .pr-h1 { max-width: 15ch; }
  .plans { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) { .plans { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .plan { position: relative; display: flex; flex-direction: column; gap: 10px; padding: clamp(24px, 3vw, 32px); border-top: 3px solid var(--acc); overflow: visible; }
  .plan.is-featured { border-color: var(--acc); box-shadow: 0 0 0 1px var(--acc), 0 30px 60px -30px color-mix(in srgb, var(--acc) 45%, transparent); }
  .plan-flag { position: absolute; top: -12px; right: 18px; background: var(--color-ridge); }
  .plan-price { font-family: var(--font-display); font-weight: 900; font-stretch: 112%; font-size: clamp(2.5rem, 4vw, 3.25rem); line-height: 1; margin: 14px 0 6px; padding-bottom: 18px; border-bottom: 1px solid var(--color-slate); }
  .plan-price.is-text { font-size: clamp(1.5rem, 2.4vw, 1.9rem); padding-top: 10px; }
  .plan-per { font-family: var(--font-mono); font-weight: 500; font-size: 0.9375rem; color: var(--color-dust); margin-left: 6px; letter-spacing: 0.02em; }
  .plan-items { list-style: none; padding: 0; margin: 6px 0 0; display: grid; gap: 10px; }
  .plan-items li { display: flex; gap: 10px; align-items: flex-start; font-size: 0.975rem; }
  .plan-items :global(svg) { color: var(--acc); flex: none; margin-top: 3px; }
  .plan-cta { margin-top: auto; align-self: flex-start; }
  .plan .fine { margin-top: 4px; }
  .plan-cta { margin-top: 18px; }
  .gear { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  @media (min-width: 900px) { .gear { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .gear { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .gear-card { position: relative; display: grid; gap: 10px; padding: 24px; align-content: start; border-top: 3px solid var(--color-sage); }
  .gear-link { text-decoration: none; }
  .gear-link::after { content: ""; position: absolute; inset: 0; }
  .gear-card:has(.gear-link:focus-visible) { outline: 2px solid var(--color-sage); outline-offset: 3px; }
  .gear-price { color: var(--color-sage); margin-top: 6px; }
  .th-grid { display: grid; gap: 24px; max-width: 900px; }
  .th-body { color: #26271f; }
  .pfaq { display: grid; gap: 40px; }
  @media (min-width: 1024px) { .pfaq { grid-template-columns: 0.8fr 1.2fr; gap: 64px; } }
</style>
