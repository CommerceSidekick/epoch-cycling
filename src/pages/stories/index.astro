---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import PageHero from "../../components/sections/PageHero.astro";
import StoryGrid from "../../components/sections/StoryGrid.astro";
import StoryFilters from "../../components/sections/StoryFilters.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/ui/Icon.astro";
import { getCollection } from "astro:content";
const count = (await getCollection("stories", (s) => !s.data.draft)).length;
---
<BaseLayout lcp="mtbFogJump"
  title="Stories | Race Reports, Ride Recaps and Fuel Talk | Epoch Cycling"
  description="Race reports, ride recaps, kit stories and straight talk on fueling from the Epoch Riders Club."
  overlayHeader
  breadcrumbs={[{ name: "Stories", path: "/stories" }]}
>
  <PageHero img="mtbFogJump" eyebrow="STORIES" size="mid" position="center 45%" speed>
    <h1 class="t-display-xl reveal">From the <span class="text-summit">trail.</span></h1>
    <p class="body-l stories-sub reveal reveal-d1">Race reports, ride recaps, fuel nerdery and the people in the crew.</p>
  </PageHero>

  <section class="section" aria-label="All stories">
    <div class="wrap">
      <h2 class="sr-only">All stories</h2>
      {count > 0 && <StoryFilters />}
      <StoryGrid>
        <div slot="empty" class="empty card topo">
          <Icon name="mountain" size={28} class="text-summit" />
          <p class="t-h3">First stories drop soon.</p>
          <Button href="/join" size="sm" location="stories-empty">Get the drop</Button>
        </div>
      </StoryGrid>
    </div>
  </section>
</BaseLayout>
<style>
  .stories-sub { margin-top: 22px; max-width: 40ch; color: #ece7dc; }
  .empty { display: grid; gap: 14px; justify-items: start; padding: clamp(28px, 4vw, 44px); border-style: dashed; }
</style>
